# .streamlit/secrets.toml
# ==============================================================================
# Instructions for connecting your private Supabase database:
# 1. Sign up for a free account at https://supabase.com
# 2. Create a new project (e.g. named "My Expense Tracker")
# 3. In your project settings, go to "API"
# 4. Copy your "Project URL" and your "anon public" key
# 5. Make a copy of this file named "secrets.toml" in this same .streamlit folder
# 6. Replace the placeholder values below with your real URL and key:
# ==============================================================================

[supabase]
url = "https://your-project-id.supabase.co"
key = "your-anon-public-key-here"
